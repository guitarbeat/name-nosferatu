{
  "name": "name-nosferatu",
  "version": "1.0.2",
  "description": "A React application for managing cat names and related data",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guitarbeat/Naming-Nosferatu.git"
  },
  "bugs": {
    "url": "https://github.com/guitarbeat/Naming-Nosferatu/issues"
  },
  "keywords": [
    "react",
    "cats",
    "names",
    "management",
    "tournament",
    "voting",
    "supabase",
    "vite"
  ],
  "author": {
    "name": "Aaron",
    "email": "aaron@example.com"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --config config/vite.config.ts --host 0.0.0.0 --port 3000",
    "build": "vite build --config config/vite.config.ts",
    "build:dev": "vite build --config config/vite.config.ts --mode development",
    "preview": "vite preview --config config/vite.config.ts",
    "lint": "biome check --config-path config/biome.json src && tsc --project config/tsconfig.json --noEmit",
    "lint:full": "biome check --config-path config/biome.json src",
    "lint:types": "tsc --project config/tsconfig.json --noEmit",
    "lint:fix": "biome check --config-path config/biome.json --write src",
    "format": "biome format --write --config-path config/biome.json src",
    "fix": "biome check --config-path config/biome.json --write src",
    "check": "npm run lint && npm run check:deps",
    "check:deps": "knip --config config/knip.json --dependencies --no-config-hints",
    "check:deps:fix": "knip --config config/knip.json --fix",
    "clean": "rm -rf build dist node_modules/.vite",
    "test": "vitest --run --config config/vitest.config.ts",
    "test:watch": "vitest --config config/vitest.config.ts",
    "test:coverage": "vitest --coverage --config config/vitest.config.ts"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@heroui/react": "^2.8.10",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@sentry/react": "^8.55.2",
    "@tanstack/react-query": "^5.101.2",
    "@types/three": "^0.185.4",
    "clsx": "2.1.1",
    "crypto-js": "^4.2.0",
    "dompurify": "^3.4.13",
    "framer-motion": "^12.42.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.27.0",
    "maath": "^0.10.8",
    "ogl": "^1.0.11",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.9.0",
    "simple-statistics": "^7.9.3",
    "tailwind-merge": "3.6.0",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@tailwindcss/vite": "4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/crypto-js": "^4.2.2",
    "@types/dom-chromium-installation-events": "^101.0.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/web-app-manifest": "^1.0.9",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.9",
    "autoprefixer": "^10.5.4",
    "jsdom": "^29.1.1",
    "knip": "^5.88.1",
    "playwright": "^1.61.1",
    "postcss": "^8.5.23",
    "sass": "^1.102.0",
    "tailwindcss": "4.3.2",
    "terser": "^5.48.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all",
      "not ie 11"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version",
      "last 1 edge version"
    ]
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/guitarbeat"
  },
  "files": [
    "build",
    "public",
    "src",
    "*.md",
    "*.json"
  ],
  "overrides": {
    "h3": "1.15.9",
    "nth-check": "^2.1.1",
    "serialize-javascript": "7.0.3",
    "form-data": "^2.5.4",
    "tough-cookie": "^4.1.3",
    "fetch-blob": "^3.2.0",
    "tar": "^7.5.11",
    "esbuild": "^0.27.3",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.27.3"
    },
    "@isaacs/brace-expansion": ">=5.0.1",
    "tar@<=7.5.2": ">=7.5.3",
    "tar@<=7.5.3": ">=7.5.4",
    "undici": "7.24.0",
    "undici@<5.29.0": ">=5.29.0",
    "undici@<6.23.0": ">=6.23.0",
    "undici@>=4.5.0 <5.28.5": ">=5.28.5",
    "glob": "13.0.6"
  }
}
